# Copy to .env and adjust as needed. Never commit a real .env file.

APP_ENV=development
LOG_LEVEL=INFO

API_KEY=change-me-demo-key

POSTGRES_USER=opspulse
POSTGRES_PASSWORD=opspulse
POSTGRES_DB=opspulse
DATABASE_URL=postgresql+asyncpg://opspulse:opspulse@postgres:5432/opspulse

# Controlled demo-failure mechanism. Must be false outside development/demo.
DEMO_MODE_ENABLED=true

# AI Incident Assistant backend: bedrock | mock | fallback
AI_BACKEND=fallback
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host-side port mappings (container-internal ports are unaffected).
# Defaults are deliberately non-standard to avoid colliding with other
# local projects that use 8000/5432/9090/3000.
APP_HOST_PORT=8080
POSTGRES_HOST_PORT=55432
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=53000
